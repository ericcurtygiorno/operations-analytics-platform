/// Central catalogue of governed KPIs used throughout the operations dashboard.
table _Measures
	lineageTag: 0962ef8d-a385-4265-8152-621480b1cbf2

	/// Distinct shipments in the current filter context.
	measure 'Total Shipments' = DISTINCTCOUNT ( Deliveries[Shipment ID] )
		formatString: #,##0
		displayFolder: 01. Volume
		lineageTag: e06846e7-8a75-48e4-9e8e-ca58fccf01da

	/// Shipments whose latest operational status is delivered.
	measure 'Delivered Shipments' =
			CALCULATE (
				[Total Shipments],
				KEEPFILTERS ( Deliveries[Delivery Status] = "delivered" )
			)
		formatString: #,##0
		displayFolder: 01. Volume
		lineageTag: 5ab44014-9cff-4ba0-9090-2c42cb831121

	/// Shipments still moving through the delivery network.
	measure 'Open Shipments' =
			CALCULATE (
				[Total Shipments],
				KEEPFILTERS ( Deliveries[Delivery Status] = "in_transit" )
			)
		formatString: #,##0
		displayFolder: 01. Volume
		lineageTag: 951a09f5-3164-4fe6-9b38-cfcd2f05a729

	/// Shipments that passed all quality rules required for SLA evaluation.
	measure 'SLA Eligible Shipments' =
			CALCULATE (
				[Total Shipments],
				KEEPFILTERS ( Deliveries[Is Valid for SLA] = TRUE () )
			)
		formatString: #,##0
		displayFolder: 02. Service Level
		lineageTag: 481aa401-9d53-40ca-be95-38246d432886

	/// SLA-eligible shipments delivered on or before the promised date.
	measure 'On-Time Deliveries' =
			CALCULATE (
				[Total Shipments],
				KEEPFILTERS ( Deliveries[Is Valid for SLA] = TRUE () ),
				KEEPFILTERS ( Deliveries[Is On Time] = TRUE () )
			)
		formatString: #,##0
		displayFolder: 02. Service Level
		lineageTag: 841cf135-5815-47df-815d-818b2284be1a

	/// SLA-eligible shipments delivered after the promised date.
	measure 'Late Deliveries' =
			CALCULATE (
				[Total Shipments],
				KEEPFILTERS ( Deliveries[Is Valid for SLA] = TRUE () ),
				KEEPFILTERS ( Deliveries[Is On Time] = FALSE () )
			)
		formatString: #,##0
		displayFolder: 02. Service Level
		lineageTag: ffc7797b-1854-490e-b4f5-5d506796ff53

	/// Share of SLA-eligible shipments delivered on time. Excluded records never enter the denominator.
	measure 'On-Time Delivery Rate' =
			DIVIDE (
				[On-Time Deliveries],
				[SLA Eligible Shipments]
			)
		formatString: 0.0%
		displayFolder: 02. Service Level
		lineageTag: 58ab032a-d693-4875-9322-de8b64542e3c

	/// Average positive delay, in days, among late SLA-eligible deliveries.
	measure 'Average Delay (Late)' =
			CALCULATE (
				AVERAGE ( Deliveries[Delivery Delay Days] ),
				KEEPFILTERS ( Deliveries[Is Valid for SLA] = TRUE () ),
				KEEPFILTERS ( Deliveries[Is On Time] = FALSE () )
			)
		formatString: #,##0.0
		displayFolder: 02. Service Level
		lineageTag: bd1468a8-118e-4372-ae83-668057d0fd46

	/// 90th percentile of positive delivery delay among late SLA-eligible shipments.
	measure 'P90 Delivery Delay' =
			CALCULATE (
				PERCENTILEX.INC (
					Deliveries,
					Deliveries[Delivery Delay Days],
					0.9
				),
				KEEPFILTERS ( Deliveries[Is Valid for SLA] = TRUE () ),
				KEEPFILTERS ( Deliveries[Is On Time] = FALSE () )
			)
		formatString: #,##0.0
		displayFolder: 02. Service Level
		lineageTag: 0f245fae-6013-460f-8ecd-d171fe042f1d

	/// Average elapsed hours from order placement to shipment dispatch.
	measure 'Average Order-to-Ship Hours' = AVERAGE ( Deliveries[Order-to-Ship Hours] )
		formatString: #,##0.0
		displayFolder: 03. Cycle Time
		lineageTag: fe69eeb7-8482-45ae-aaa6-484cec5f6a04

	/// Average elapsed days from shipment dispatch to delivery.
	measure 'Average Ship-to-Delivery Days' =
			DIVIDE (
				AVERAGE ( Deliveries[Ship-to-Delivery Hours] ),
				24
			)
		formatString: #,##0.0
		displayFolder: 03. Cycle Time
		lineageTag: 150b24be-4d90-4922-a04b-68b5d45fa148

	/// Delivered shipments completed on the first attempt.
	measure 'First-Attempt Deliveries' =
			CALCULATE (
				[Total Shipments],
				KEEPFILTERS ( Deliveries[Delivery Status] = "delivered" ),
				KEEPFILTERS ( Deliveries[Delivery Attempts] = 1 )
			)
		formatString: #,##0
		displayFolder: 04. Attempts & Exceptions
		lineageTag: 48b54c6d-12e6-421e-acee-a2bea83013cf

	/// Share of delivered shipments completed on the first attempt.
	measure 'First-Attempt Success Rate' =
			DIVIDE (
				[First-Attempt Deliveries],
				[Delivered Shipments]
			)
		formatString: 0.0%
		displayFolder: 04. Attempts & Exceptions
		lineageTag: 5894e9af-3b36-4521-9ec9-928f4a2cff0e

	/// Shipments with at least one recorded exception event.
	measure 'Shipments with Exceptions' =
			CALCULATE (
				[Total Shipments],
				KEEPFILTERS ( Deliveries[Exception Count] > 0 )
			)
		formatString: #,##0
		displayFolder: 04. Attempts & Exceptions
		lineageTag: 18c0c10b-8158-4279-9225-d081f43e62b7

	/// Share of shipments with at least one recorded exception event.
	measure 'Exception Rate' =
			DIVIDE (
				[Shipments with Exceptions],
				[Total Shipments]
			)
		formatString: 0.0%
		displayFolder: 04. Attempts & Exceptions
		lineageTag: 2302ed1f-e1f0-4237-ab67-ddaad3bcdd31

	/// Sum of all recorded delivery attempts.
	measure 'Total Delivery Attempts' = SUM ( Deliveries[Delivery Attempts] )
		formatString: #,##0
		displayFolder: 04. Attempts & Exceptions
		lineageTag: c23573f0-643f-40b2-9938-c2ad13137fa9

	/// Total freight amount for shipments in the current filter context.
	measure 'Total Freight Amount' = SUM ( Deliveries[Freight Amount] )
		formatString: "R$" #,##0.00
		displayFolder: 05. Cost & Volume
		lineageTag: 7f1d624d-d5fa-4076-b967-dc21888e788e

	/// Average freight amount per shipment.
	measure 'Average Freight per Shipment' =
			DIVIDE (
				[Total Freight Amount],
				[Total Shipments]
			)
		formatString: "R$" #,##0.00
		displayFolder: 05. Cost & Volume
		lineageTag: 0eb099dc-b589-4e01-aeae-316657554ab5

	/// Total shipped weight in kilograms.
	measure 'Total Weight (kg)' = SUM ( Deliveries[Weight (kg)] )
		formatString: #,##0.0
		displayFolder: 05. Cost & Volume
		lineageTag: 6a40bbfc-0f28-4d6c-b8d9-1abdcde41c80

	/// Total number of units represented by the shipments.
	measure 'Total Units' = SUM ( Deliveries[Quantity] )
		formatString: #,##0
		displayFolder: 05. Cost & Volume
		lineageTag: be762d62-1770-443a-bdf7-1ba7a03527d0

	/// Shipments removed from SLA calculations by governed quality rules.
	measure 'Excluded from SLA' =
			CALCULATE (
				[Total Shipments],
				KEEPFILTERS ( Deliveries[Is Valid for SLA] = FALSE () )
			)
		formatString: #,##0
		displayFolder: 06. Data Quality
		lineageTag: 644cfd8e-95d7-481a-b129-ce7cd3fec8a3

	/// Share of shipments excluded from SLA calculations.
	measure 'SLA Exclusion Rate' =
			DIVIDE (
				[Excluded from SLA],
				[Total Shipments]
			)
		formatString: 0.0%
		displayFolder: 06. Data Quality
		lineageTag: a27f009a-83dd-40b4-9adb-cc9a548dbf3d

	/// Shipments whose source order could not be matched.
	measure 'Orphan Shipments' =
			CALCULATE (
				[Total Shipments],
				KEEPFILTERS ( Deliveries[Is Orphan Order] = TRUE () )
			)
		formatString: #,##0
		displayFolder: 06. Data Quality
		lineageTag: 79124f1e-eafa-4251-bb18-79d2ba57dd7e

	/// Shipments assigned to an unknown carrier member.
	measure 'Unknown Carrier Shipments' =
			CALCULATE (
				[Total Shipments],
				KEEPFILTERS ( Deliveries[Is Unknown Carrier] = TRUE () )
			)
		formatString: #,##0
		displayFolder: 06. Data Quality
		lineageTag: 6fc1c632-44d6-48e0-8f71-4354b3aae06e

	/// Shipments whose delivered timestamp occurs before the shipped timestamp.
	measure 'Invalid Timeline Shipments' =
			CALCULATE (
				[Total Shipments],
				KEEPFILTERS ( Deliveries[Is Delivery Before Shipment] = TRUE () )
			)
		formatString: #,##0
		displayFolder: 06. Data Quality
		lineageTag: 634e991c-bfd7-4896-bd83-0da7fc31f689

	/// Delivered shipments that do not have a delivery timestamp.
	measure 'Delivered Without Timestamp' =
			CALCULATE (
				[Total Shipments],
				KEEPFILTERS ( Deliveries[Is Delivered Without Timestamp] = TRUE () )
			)
		formatString: #,##0
		displayFolder: 06. Data Quality
		lineageTag: 88117e0c-0969-43df-99f2-867d36a81f8b

	/// Shipments containing one or more material data-quality defects.
	measure 'Shipments with Data Quality Issues' =
			CALCULATE (
				[Total Shipments],
				FILTER (
					Deliveries,
					Deliveries[Is Orphan Order]
						|| Deliveries[Is Unknown Carrier]
						|| Deliveries[Is Delivery Before Shipment]
						|| Deliveries[Is Delivered Without Timestamp]
						|| Deliveries[Has Invalid Order]
				)
			)
		formatString: #,##0
		displayFolder: 06. Data Quality
		lineageTag: a085fe89-5f30-40d9-b317-ef4187b69c53

	/// On-time delivery rate for the immediately preceding calendar month.
	measure 'On-Time Delivery Rate Previous Month' =
			CALCULATE (
				[On-Time Delivery Rate],
				PREVIOUSMONTH ( Dates[Date] )
			)
		formatString: 0.0%
		displayFolder: 07. Time Intelligence
		lineageTag: 86af79b7-0573-452f-8246-41be2585f89a

	/// Percentage-point movement in on-time delivery rate versus the previous month.
	measure 'On-Time Delivery MoM (pp)' =
			VAR _CurrentRate =
				[On-Time Delivery Rate]
			VAR _PreviousRate =
				[On-Time Delivery Rate Previous Month]
			RETURN
				IF (
					NOT ISBLANK ( _PreviousRate ),
					( _CurrentRate - _PreviousRate ) * 100
				)
		formatString: +0.0;-0.0;0.0
		displayFolder: 07. Time Intelligence
		lineageTag: b187a69a-6352-476f-b8af-399f3c34980c

	/// Shipment volume for the immediately preceding calendar month.
	measure 'Shipments Previous Month' =
			CALCULATE (
				[Total Shipments],
				PREVIOUSMONTH ( Dates[Date] )
			)
		formatString: #,##0
		displayFolder: 07. Time Intelligence
		lineageTag: cac88b20-72f2-41f2-9b16-3f71cd1aa4a4

	/// Percentage change in shipment volume versus the previous month.
	measure 'Shipments MoM' =
			VAR _PreviousShipments =
				[Shipments Previous Month]
			RETURN
				DIVIDE (
					[Total Shipments] - _PreviousShipments,
					_PreviousShipments
				)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 07. Time Intelligence
		lineageTag: 539e0c35-1cdb-45a2-a5fe-c630993ed8e0

	/// On-Time Delivery Rate for the latest year in the model, preserving month and business filters.
	measure 'On-Time Delivery Rate | Current YTD' =
			VAR _SelectedYear =
				SELECTEDVALUE ( Dates[Year] )
			VAR _CurrentYear =
				COALESCE (
					_SelectedYear,
					CALCULATE (
						MAX ( Dates[Year] ),
						REMOVEFILTERS ( Dates )
					)
				)
			RETURN
				CALCULATE (
					[On-Time Delivery Rate],
					REMOVEFILTERS ( Dates[Year] ),
					Dates[Year] = _CurrentYear
				)
		formatString: 0.0%
		displayFolder: 08. KPI Comparisons\On-Time Delivery Rate
		lineageTag: 47de18da-dacf-4408-9db7-474a5f6286a0

	/// On-Time Delivery Rate for the prior year using the same selected months, or Jan through the latest current-year month.
	measure 'On-Time Delivery Rate | Prior YTD' =
			VAR _SelectedYear =
				SELECTEDVALUE ( Dates[Year] )
			VAR _CurrentYear =
				COALESCE (
					_SelectedYear,
					CALCULATE (
						MAX ( Dates[Year] ),
						REMOVEFILTERS ( Dates )
					)
				)
			VAR _CurrentMaxMonth =
				MONTH (
					CALCULATE (
						MAX ( Dates[Date] ),
						REMOVEFILTERS ( Dates ),
						Dates[Year] = _CurrentYear
					)
				)
			VAR _HasMonthFilter =
				ISFILTERED ( Dates[Month] )
					|| ISFILTERED ( Dates[Month Number] )
			RETURN
				IF (
					_HasMonthFilter,
					CALCULATE (
						[On-Time Delivery Rate],
						REMOVEFILTERS ( Dates[Year] ),
						Dates[Year] = _CurrentYear - 1
					),
					CALCULATE (
						[On-Time Delivery Rate],
						REMOVEFILTERS ( Dates[Year] ),
						Dates[Year] = _CurrentYear - 1,
						KEEPFILTERS ( Dates[Month Number] <= _CurrentMaxMonth )
					)
				)
		formatString: 0.0%
		displayFolder: 08. KPI Comparisons\On-Time Delivery Rate
		lineageTag: f1838a24-704d-48ac-bf85-108368e550f9

	/// Year-over-year change for On-Time Delivery Rate in percentage points.
	measure 'On-Time Delivery Rate | YoY' =
			VAR _CurrentValue =
				[On-Time Delivery Rate | Current YTD]
			VAR _PriorValue =
				[On-Time Delivery Rate | Prior YTD]
			RETURN
				( _CurrentValue - _PriorValue ) * 100
		formatString: +0.0 "pp";-0.0 "pp";0.0 "pp"
		displayFolder: 08. KPI Comparisons\On-Time Delivery Rate
		lineageTag: 62845454-1db5-4b36-9269-c9ce90d4f474

	/// Business definition displayed in report tooltips.
	measure 'On-Time Delivery Rate | Definition' = "On-time deliveries divided by SLA-eligible shipments. Records that fail governed data-quality rules are excluded from the denominator. When one year is selected, it is the current period; with multiple years selected, the latest year is current. Prior YTD uses the same selected months from the preceding year."
		displayFolder: 08. KPI Comparisons\On-Time Delivery Rate
		lineageTag: b807935e-ea21-4174-abd7-c8be53f4cbed

	/// Total Shipments for the latest year in the model, preserving month and business filters.
	measure 'Total Shipments | Current YTD' =
			VAR _SelectedYear =
				SELECTEDVALUE ( Dates[Year] )
			VAR _CurrentYear =
				COALESCE (
					_SelectedYear,
					CALCULATE (
						MAX ( Dates[Year] ),
						REMOVEFILTERS ( Dates )
					)
				)
			RETURN
				CALCULATE (
					[Total Shipments],
					REMOVEFILTERS ( Dates[Year] ),
					Dates[Year] = _CurrentYear
				)
		formatString: #,##0
		displayFolder: 08. KPI Comparisons\Total Shipments
		lineageTag: a0ee1ac3-c294-4291-8353-97593a8cc830

	/// Total Shipments for the prior year using the same selected months, or Jan through the latest current-year month.
	measure 'Total Shipments | Prior YTD' =
			VAR _SelectedYear =
				SELECTEDVALUE ( Dates[Year] )
			VAR _CurrentYear =
				COALESCE (
					_SelectedYear,
					CALCULATE (
						MAX ( Dates[Year] ),
						REMOVEFILTERS ( Dates )
					)
				)
			VAR _CurrentMaxMonth =
				MONTH (
					CALCULATE (
						MAX ( Dates[Date] ),
						REMOVEFILTERS ( Dates ),
						Dates[Year] = _CurrentYear
					)
				)
			VAR _HasMonthFilter =
				ISFILTERED ( Dates[Month] )
					|| ISFILTERED ( Dates[Month Number] )
			RETURN
				IF (
					_HasMonthFilter,
					CALCULATE (
						[Total Shipments],
						REMOVEFILTERS ( Dates[Year] ),
						Dates[Year] = _CurrentYear - 1
					),
					CALCULATE (
						[Total Shipments],
						REMOVEFILTERS ( Dates[Year] ),
						Dates[Year] = _CurrentYear - 1,
						KEEPFILTERS ( Dates[Month Number] <= _CurrentMaxMonth )
					)
				)
		formatString: #,##0
		displayFolder: 08. KPI Comparisons\Total Shipments
		lineageTag: 974f885b-1d98-4b3a-aa20-b890ea0a3f43

	/// Year-over-year change for Total Shipments.
	measure 'Total Shipments | YoY' =
			VAR _CurrentValue =
				[Total Shipments | Current YTD]
			VAR _PriorValue =
				[Total Shipments | Prior YTD]
			RETURN
				DIVIDE ( _CurrentValue - _PriorValue, _PriorValue )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 08. KPI Comparisons\Total Shipments
		lineageTag: 71c88080-e8a0-45fa-9e68-10fc31a4127d

	/// Business definition displayed in report tooltips.
	measure 'Total Shipments | Definition' = "Distinct shipments in the selected business context. When one year is selected, it is the current period; with multiple years selected, the latest year is current. Prior YTD uses the same selected months from the preceding year."
		displayFolder: 08. KPI Comparisons\Total Shipments
		lineageTag: f52a9186-ea0d-4c5e-8f09-527ffabf25ea

	/// Average Delay (Late) for the latest year in the model, preserving month and business filters.
	measure 'Average Delay (Late) | Current YTD' =
			VAR _SelectedYear =
				SELECTEDVALUE ( Dates[Year] )
			VAR _CurrentYear =
				COALESCE (
					_SelectedYear,
					CALCULATE (
						MAX ( Dates[Year] ),
						REMOVEFILTERS ( Dates )
					)
				)
			RETURN
				CALCULATE (
					[Average Delay (Late)],
					REMOVEFILTERS ( Dates[Year] ),
					Dates[Year] = _CurrentYear
				)
		formatString: #,##0.0
		displayFolder: 08. KPI Comparisons\Average Delay (Late)
		lineageTag: 465c4764-ca7d-4c6e-9fbd-b0eeb95d567d

	/// Average Delay (Late) for the prior year using the same selected months, or Jan through the latest current-year month.
	measure 'Average Delay (Late) | Prior YTD' =
			VAR _SelectedYear =
				SELECTEDVALUE ( Dates[Year] )
			VAR _CurrentYear =
				COALESCE (
					_SelectedYear,
					CALCULATE (
						MAX ( Dates[Year] ),
						REMOVEFILTERS ( Dates )
					)
				)
			VAR _CurrentMaxMonth =
				MONTH (
					CALCULATE (
						MAX ( Dates[Date] ),
						REMOVEFILTERS ( Dates ),
						Dates[Year] = _CurrentYear
					)
				)
			VAR _HasMonthFilter =
				ISFILTERED ( Dates[Month] )
					|| ISFILTERED ( Dates[Month Number] )
			RETURN
				IF (
					_HasMonthFilter,
					CALCULATE (
						[Average Delay (Late)],
						REMOVEFILTERS ( Dates[Year] ),
						Dates[Year] = _CurrentYear - 1
					),
					CALCULATE (
						[Average Delay (Late)],
						REMOVEFILTERS ( Dates[Year] ),
						Dates[Year] = _CurrentYear - 1,
						KEEPFILTERS ( Dates[Month Number] <= _CurrentMaxMonth )
					)
				)
		formatString: #,##0.0
		displayFolder: 08. KPI Comparisons\Average Delay (Late)
		lineageTag: 185ec851-b96e-4012-bf2b-d5c2923993a4

	/// Year-over-year change for Average Delay (Late).
	measure 'Average Delay (Late) | YoY' =
			VAR _CurrentValue =
				[Average Delay (Late) | Current YTD]
			VAR _PriorValue =
				[Average Delay (Late) | Prior YTD]
			RETURN
				DIVIDE ( _CurrentValue - _PriorValue, _PriorValue )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 08. KPI Comparisons\Average Delay (Late)
		lineageTag: d973a384-3d23-4897-95d6-a53beb89e2e9

	/// Business definition displayed in report tooltips.
	measure 'Average Delay (Late) | Definition' = "Average positive delivery delay in days among late, SLA-eligible deliveries only. When one year is selected, it is the current period; with multiple years selected, the latest year is current. Prior YTD uses the same selected months from the preceding year."
		displayFolder: 08. KPI Comparisons\Average Delay (Late)
		lineageTag: 4e2d1936-b49d-4c70-9ba0-1b7a73071145

	/// SLA Exclusion Rate for the latest year in the model, preserving month and business filters.
	measure 'SLA Exclusion Rate | Current YTD' =
			VAR _SelectedYear =
				SELECTEDVALUE ( Dates[Year] )
			VAR _CurrentYear =
				COALESCE (
					_SelectedYear,
					CALCULATE (
						MAX ( Dates[Year] ),
						REMOVEFILTERS ( Dates )
					)
				)
			RETURN
				CALCULATE (
					[SLA Exclusion Rate],
					REMOVEFILTERS ( Dates[Year] ),
					Dates[Year] = _CurrentYear
				)
		formatString: 0.0%
		displayFolder: 08. KPI Comparisons\SLA Exclusion Rate
		lineageTag: 5398c7a4-760b-478c-80db-4c1da6b7c1b0

	/// SLA Exclusion Rate for the prior year using the same selected months, or Jan through the latest current-year month.
	measure 'SLA Exclusion Rate | Prior YTD' =
			VAR _SelectedYear =
				SELECTEDVALUE ( Dates[Year] )
			VAR _CurrentYear =
				COALESCE (
					_SelectedYear,
					CALCULATE (
						MAX ( Dates[Year] ),
						REMOVEFILTERS ( Dates )
					)
				)
			VAR _CurrentMaxMonth =
				MONTH (
					CALCULATE (
						MAX ( Dates[Date] ),
						REMOVEFILTERS ( Dates ),
						Dates[Year] = _CurrentYear
					)
				)
			VAR _HasMonthFilter =
				ISFILTERED ( Dates[Month] )
					|| ISFILTERED ( Dates[Month Number] )
			RETURN
				IF (
					_HasMonthFilter,
					CALCULATE (
						[SLA Exclusion Rate],
						REMOVEFILTERS ( Dates[Year] ),
						Dates[Year] = _CurrentYear - 1
					),
					CALCULATE (
						[SLA Exclusion Rate],
						REMOVEFILTERS ( Dates[Year] ),
						Dates[Year] = _CurrentYear - 1,
						KEEPFILTERS ( Dates[Month Number] <= _CurrentMaxMonth )
					)
				)
		formatString: 0.0%
		displayFolder: 08. KPI Comparisons\SLA Exclusion Rate
		lineageTag: 9b814b54-f996-412c-bcd4-603a30ff20e3

	/// Year-over-year change for SLA Exclusion Rate in percentage points.
	measure 'SLA Exclusion Rate | YoY' =
			VAR _CurrentValue =
				[SLA Exclusion Rate | Current YTD]
			VAR _PriorValue =
				[SLA Exclusion Rate | Prior YTD]
			RETURN
				( _CurrentValue - _PriorValue ) * 100
		formatString: +0.0 "pp";-0.0 "pp";0.0 "pp"
		displayFolder: 08. KPI Comparisons\SLA Exclusion Rate
		lineageTag: 4b021fa6-9efd-4466-aada-14ce7ebeacc0

	/// Business definition displayed in report tooltips.
	measure 'SLA Exclusion Rate | Definition' = "Shipments excluded by governed quality rules divided by all shipments. When one year is selected, it is the current period; with multiple years selected, the latest year is current. Prior YTD uses the same selected months from the preceding year."
