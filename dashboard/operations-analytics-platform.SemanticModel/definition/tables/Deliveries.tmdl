	column 'Order Date Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5ea5b062-063d-4597-b7ee-41084b254014
		summarizeBy: none
		sourceColumn: order_date_key

	column 'Shipped Date Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9c722b47-7a20-4249-9edb-9ea04be62e9c
		summarizeBy: none
