	/// Shipment weight in kilograms.
	column 'Weight (kg)'
		dataType: double
		isHidden
		formatString: #,##0.0
		lineageTag: 52cd5b08-c09b-45a8-8b7d-ff41f82da5ed
		summarizeBy: none
		sourceColumn: weight_kg

	/// Freight amount associated with the shipment.
	column 'Freight Amount'
		dataType: double
		isHidden
		formatString: "R$" #,##0.00
		lineageTag: 65ad732b-d131-440a-aa24-b6220976ab8b
		summarizeBy: none
		sourceColumn: freight_amount

	/// Number of tracking events recorded for the shipment.
	column 'Event Count'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fefa6117-605d-4344-b9a6-6fc1bd430635
		summarizeBy: none
		sourceColumn: event_count

	/// Number of exception events recorded for the shipment.
	column 'Exception Count'
		dataType: int64
		formatString: 0
		lineageTag: 8d8b60eb-8e18-4a4f-af5c-89f73650daad
		summarizeBy: none
		sourceColumn: exception_count

	/// Most recent operational failure category, when present.
	column 'Failure Reason'
		dataType: string
		lineageTag: 851f547f-a618-450c-9050-fabae6571ab6
		summarizeBy: none
		sourceColumn: failure_reason

	/// Elapsed hours from order creation to shipment dispatch.
	column 'Order-to-Ship Hours'
		dataType: double
		isHidden
		formatString: #,##0.0
		lineageTag: 6ad9671a-e12b-4b7c-b52a-28eaab3b85d1
		summarizeBy: none
		sourceColumn: order_to_ship_hours

	/// Elapsed hours from shipment dispatch to delivery.
	column 'Ship-to-Delivery Hours'
		dataType: double
		isHidden
		formatString: #,##0.0
		lineageTag: 0e6eb000-207f-40c9-b423-44d7717797c5
		summarizeBy: none
		sourceColumn: ship_to_delivery_hours

	/// Signed difference in days between actual and promised delivery.
	column 'Delivery Delay Days'
		dataType: double
		formatString: #,##0.0
		lineageTag: ca339473-1b75-44bc-bc00-27e6f46331a8
		summarizeBy: none
		sourceColumn: delivery_delay_days

	/// True when a valid shipment was delivered on or before promise.
	column 'Is On Time'
		dataType: boolean
		lineageTag: 11e2cba7-f377-4ced-abf6-446eac76efbe
		summarizeBy: none
		sourceColumn: is_on_time

	/// True when the shipment passes all rules required for the SLA denominator.
	column 'Is Valid for SLA'
		dataType: boolean
		lineageTag: 0115e185-ac36-48aa-9c33-3be248c0c31b
		summarizeBy: none
		sourceColumn: is_valid_for_sla

	/// True when no valid source order could be matched.
	column 'Is Orphan Order'
		dataType: boolean
		lineageTag: 6582b3a5-ebb2-4faa-b892-2897114abcf2
		summarizeBy: none
		sourceColumn: is_orphan_order

	/// True when the shipment uses the governed unknown carrier member.
	column 'Is Unknown Carrier'
		dataType: boolean
		lineageTag: 03193f8e-5921-460f-b2fa-4f9e5101a270
		summarizeBy: none
		sourceColumn: is_unknown_carrier

	/// True when the delivery timestamp precedes the shipment timestamp.
	column 'Is Delivery Before Shipment'
		dataType: boolean
		lineageTag: 69ad2a62-73c9-4a3d-99d4-cc648419a471
		summarizeBy: none
		sourceColumn: is_delivery_before_shipment

	/// True when a delivered status has no delivery timestamp.
	column 'Is Delivered Without Timestamp'
		dataType: boolean
		lineageTag: 6e9d03af-0800-46a1-a70a-0f6727d60645
		summarizeBy: none
		sourceColumn: is_delivered_without_timestamp

	/// True when the source order contains an upstream validity defect.
	column 'Has Invalid Order'
		dataType: boolean
		lineageTag: 1df80a3b-533f-4a0a-9859-4f7845c90492
		summarizeBy: none
		sourceColumn: has_invalid_order

	column 'Source Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: d92fabd7-7bc0-4e16-b267-9c775cd7560d
		summarizeBy: none
		sourceColumn: source_batch_id

	column 'Load ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 0096c17f-aee2-4241-9f39-901bc39828d5
		summarizeBy: none
		sourceColumn: _load_id

	column 'Ingested At'
		dataType: dateTime
		isHidden
		formatString: General Date
		isAvailableInMdx: false
		lineageTag: b58d6976-fa50-4720-ba7e-4304a091b52b
		summarizeBy: none
		sourceColumn: _ingested_at

	partition 'marts fact_deliveries' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:55432", "operations_analytics"),
				    DeliveryFact = Source{[Schema="marts",Item="fact_deliveries"]}[Data]
				in
				    DeliveryFact

	annotation PBI_ResultType = Table

