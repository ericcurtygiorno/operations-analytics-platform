/// One row per shipment with lifecycle, SLA, cost, exception, and quality attributes.
table Deliveries
	lineageTag: 410b1e6b-05ab-4759-899a-4149df14b7dd

	/// Unique shipment identifier at the table grain.
	column 'Shipment ID'
		dataType: string
		lineageTag: df4990c4-36b3-45d0-9270-02b14f843ed9
		summarizeBy: none
		sourceColumn: shipment_id

	/// Source-system order identifier associated with the shipment.
