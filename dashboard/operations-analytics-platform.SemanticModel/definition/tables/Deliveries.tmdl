		sourceColumn: delivered_date_key

	/// Timestamp when the customer order was created.
	column 'Ordered At'
		dataType: dateTime
		formatString: General Date
		lineageTag: 47b24318-d349-475d-8400-2d8166b70861
		summarizeBy: none
		sourceColumn: order_at

	/// Timestamp when the shipment left the distribution center.
	column 'Shipped At'
		dataType: dateTime
		formatString: General Date
		lineageTag: a7ad5f76-0021-41ff-8436-709d086e0a20
		summarizeBy: none
		sourceColumn: shipped_at

	/// Contractual delivery timestamp used to assess SLA performance.
	column 'Promised Delivery At'
		dataType: dateTime
		formatString: General Date
		lineageTag: 3c3dd869-5960-4be5-8a4d-1605ccc8da16
		summarizeBy: none
		sourceColumn: promised_delivery_at

	/// Actual delivery timestamp when available.
	column 'Delivered At'
		dataType: dateTime
		formatString: General Date
		lineageTag: dcf259a0-6fd5-4b0b-8492-750db172154b
		summarizeBy: none
		sourceColumn: delivered_at

	/// Latest operational shipment status.
	column 'Delivery Status'
		dataType: string
		lineageTag: 3c8e56c0-53cd-4658-9e9f-7af22cfdb8b5
		summarizeBy: none
		sourceColumn: delivery_status

	/// Number of delivery attempts recorded for the shipment.
	column 'Delivery Attempts'
		dataType: int64
		formatString: 0
		lineageTag: ce1c356e-17cb-4d93-90b1-205249ae440b
