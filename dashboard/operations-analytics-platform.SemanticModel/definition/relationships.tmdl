relationship 'Deliveries to Carriers'
	fromColumn: Deliveries.'Carrier Key'
	toColumn: Carriers.'Carrier Key'

relationship 'Deliveries to Customers'
	fromColumn: Deliveries.'Customer Key'
	toColumn: Customers.'Customer Key'

relationship 'Deliveries to Distribution Centers'
	fromColumn: Deliveries.'Distribution Center Key'
	toColumn: 'Distribution Centers'.'Distribution Center Key'

relationship 'Deliveries to Locations'
